---
import Aside from './Aside.astro'
import Project from './Project.astro'

const posts = Object.values(import.meta.glob('./project-list/*.md', { eager: true }));
---

<Aside className={['h-full']}>
    <div class="text-2xl">
        Projects && Articles
    </div>

    <div class="projects max-h-[440px] xl:max-h-[600px] 2xl:max-h-[480px] mt-[-10px] flex relative px-2 rounded-lg overflow-hidden">
        <div class="projects-wrap overflow-y-auto pr-2 py-2">
            {posts.map(post =>
              <Project
                title={post.frontmatter.title}
                git={post.frontmatter?.github}
                preview={post.frontmatter?.preview}
                links={post.frontmatter?.links}
                content={post.rawContent}
              />
            )}
        </div>

        <div class="bottom"></div>
    </div>
</Aside>

<style lang="postcss">
    .projects {
        background: #58296185;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);

        .projects-wrap {
            & {
                scrollbar-width: auto;
                scrollbar-color: #8f54a0 #161616;
            }

            /* Chrome, Edge, and Safari */
            &::-webkit-scrollbar {
                width: 16px;
            }

            &::-webkit-scrollbar-track {
                background: #161616;
            }

            &::-webkit-scrollbar-thumb {
                background-color: #8f54a0;
                border-radius: 10px;
                border: 3px solid #161616;
            }
        }


        &::before, .bottom {
            z-index: 1;
            content: '';
            left: 0;
            width: 100%;
            height: 20px;
            position: absolute;
            background: linear-gradient(transparent 0%, #582961 90%);
        }

        &::before {
            top: 0;
            transform: rotate(180deg);
        }

        .bottom {
            bottom: 0;
        }
    }
</style>