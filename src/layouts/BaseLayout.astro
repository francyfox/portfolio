---
import FormProvider from '../components/FormProvider.vue'
import backgroundImage from '../assets/bg.webp?url';
import '@fontsource/racing-sans-one';
import racingSansOne from '@fontsource/racing-sans-one/files/racing-sans-one-latin-400-normal.woff2?url';
import '@fontsource/qwigley';
import qwigley from '@fontsource/qwigley/files/qwigley-latin-400-normal.woff2?url';
import '../assets/style.pcss'
import {
    getSecret,
} from 'astro:env/server';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights  from "@vercel/speed-insights/astro"
import GoogleTag from '../components/GoogleTag.astro'
import YandexTag from '../components/YandexTag.astro'

export const prerender = true

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const title = 'GD Portfolio | Golota Danil — web frontend developer'
const description = 'Site portfolio. Web dev from Qazaqstan. Tech stack Vue, Nuxt, Astro'

const turnstileSiteKey = getSecret('TUNRNSTILE_SITE_KEY');
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="yandex-verification" content="b384d10badb4f1fd" />

    <link rel="preconnect" href="https://img.shields.io" crossorigin />
    <link rel="preload" as="image" href={backgroundImage} />
    <link rel="preload" as="font" type="font/woff2" href={racingSansOne} />
    <link rel="preload" as="font" type="font/woff2" href={qwigley} />

    <meta property="og:url" content={Astro.site} />
    <meta property="og:type" content="website">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}/favicon.svg`} />
    <meta property="og:site_name" content="GD Portfolio" />
    <meta property="og:locale" content="en_EN" />

    <meta name="generator" content={Astro.generator} />
    <script src="https://app.rybbit.io/api/script.js" data-site-id="868" defer />
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Данил Голота",
          "jobTitle": "Frontend Developer",
          "url": "https://portfolio.shalotts.site",
          "sameAs": ["https://github.com/francyfox", "https://t.me/francyfox"]
        }
    </script>
    <YandexTag />
    <GoogleTag />
</head>
<body>
    <slot />
    <FormProvider
      client:load
      client:only="vue"
      turnstileSiteKey={turnstileSiteKey}
    />
    <Analytics />
    <SpeedInsights />
</body>
</html>


<style lang="postcss" define:vars={{ backgroundImage: `url(${backgroundImage})` }}>
    body {
        background-color: #161616;
        background-image: var(--backgroundImage);
        background-size: cover;
        background-position: center center;
    }
</style>