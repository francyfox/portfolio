---
import backgroundImage from '../assets/bg.webp?url';
import '@fontsource/racing-sans-one';
import '@fontsource/qwigley';
import '../assets/style.pcss'

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const title = 'GD Portfolio | Golota Danil — web frontend developer'
const description = 'Site portfolio. Web dev from Qazaqstan. Tech stack Vue, Nuxt, Astro'
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:url" content={Astro.site} />
    <meta property="og:type" content="website">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="generator" content={Astro.generator} />
</head>
<body>
<slot />
</body>
</html>


<style lang="postcss" define:vars={{ backgroundImage: `url(${backgroundImage})` }}>
    body {
        background-color: #161616;
        background-image: var(--backgroundImage);
        background-size: cover;
        background-position: center center;
    }
</style>